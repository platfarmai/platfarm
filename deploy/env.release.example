# Minimal env for deploy/compose.release.yml (copy to .env).
PF_IMAGE_TAG=latest
# AUTH database only. Do not point this at a plugin DB (e.g. pf_svc_ads) or auth loses its users table.
DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_auth
BUNDLED_DB_PASSWORD=platfarm_local
PF_REDIS_URL=redis://redis:6379/0
KONG_YAML=./gateway/kong.yml
PF_KEYS_DIR=./.keys
PF_WORKSPACE=.
# Generate keys once on a machine with pctl, then copy .keys/ here (private key only for auth).
