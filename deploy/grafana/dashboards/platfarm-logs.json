{
  "uid": "pf-logs",
  "title": "Platfarm · 日志总览",
  "tags": ["platfarm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(service)",
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "requestId",
        "type": "textbox",
        "label": "X-Request-Id",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "日志量 by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({service=~\"$service\"}[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "网关 5xx 速率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (count_over_time({service_name=\"platfarm-gateway\", status=~\"5..\"}[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "错误日志（error/fatal 或含 error 字样）",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} |~ \"(?i)(\\\"level\\\":\\\"(error|fatal)\\\"|error)\""
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "按 X-Request-Id 关联全链路（附录 B）",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Ascending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\".+\"} |= \"$requestId\""
        }
      ]
    }
  ]
}
