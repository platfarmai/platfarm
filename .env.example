# ══════════════════════════════════════════════════════════════
# Platfarm 环境配置模板：cp .env.example .env 后按需修改
# ══════════════════════════════════════════════════════════════

# ── 容器运行时（Docker / Podman / nerdctl）──────────────────
# 宿主机 CLI：不设则 PATH 上第一个 docker|podman|nerdctl
#PF_CONTAINER_CLI=docker
# Console 挂载的引擎 socket（容器内仍映射为 /var/run/docker.sock）
# Docker 默认即可；Podman 示例：
#PF_CONTAINER_SOCKET=/run/user/1000/podman/podman.sock

# ── JWT：RS256 密钥对自动生成（.keys/，gitignore）────────────
# 首次 pctl sync 或 auth 启动时自举；生产环境用密钥管理分发私钥、只挂载给 auth
# （无需在本文件配置任何 JWT 密钥）

# ── 数据库（必填，三种模式选一）──────────────────────────────
#
# 模式 A：捆绑容器（开箱即用，推荐新环境）
#   启动：docker compose --profile bundled-db up -d
DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_auth
#BUNDLED_DB_PASSWORD=platfarm_local
#
# 模式 B：宿主机/外部已有 PostgreSQL 实例
#   先建库：CREATE ROLE platfarm LOGIN PASSWORD '...'; CREATE DATABASE pf_auth OWNER platfarm;
#DATABASE_URL=postgres://platfarm:platfarm_local@host.docker.internal:15433/pf_auth
#
# 模式 C：AWS RDS PostgreSQL（生产）
#   - RDS 开启 require_secure_transport 时必须带 sslmode（require 起步；verify-full 需 CA）
#   - CA 证书（verify-full 时）：https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
#   - 密码用 SSM Parameter Store (SecureString) 注入，勿写明文进 .env
#   - 安全组：RDS SG 入站放行 5432 ← 应用所在 SG；同 VPC 即可，不必同子网
#DATABASE_URL=postgres://platfarm:PASS@your-instance.xxxx.us-west-2.rds.amazonaws.com:5432/pf_auth?sslmode=require

# ── Redis（多副本 --scale 必填；单副本默认连 compose 内 redis）──
# auth / oauth 直接解析整串 URL；pctl sync 会把 host/port/password/username/db/ssl 写入 Kong
PF_REDIS_URL=redis://redis:6379/0
# 有密码：        redis://:SECRET@redis:6379/0
# ACL 用户+密码： redis://myuser:SECRET@redis:6379/0
# TLS：           rediss://:SECRET@xxx.cache.amazonaws.com:6379/0
# 密码含 @:/# 等须 URL 编码（@→%40）
# 改 PF_REDIS_URL 后执行 pctl sync && docker compose up -d（不必重打 auth 镜像）
# 多副本时建议 KONG_NGINX_WORKER_PROCESSES=auto
#KONG_NGINX_WORKER_PROCESSES=auto

# 计量（specs/013，observability profile 启用时）
# LOKI_URL=http://loki:3100
# Grafana 管理密码（specs/019，默认 admin，仅本机 18002）
#GF_ADMIN_PASSWORD=admin

# ── svc-file 文件服务（specs/016）────────────────────────────
# 自有库（bundled-db 新卷自动建；存量/外部库手工：CREATE DATABASE pf_svc_file OWNER platfarm;）
FILE_DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_svc_file
# MinIO 凭据（--profile bundled-s3 启用捆绑 minio；外部 S3/OSS 改下面两个 ENDPOINT 即可）
S3_ACCESS_KEY=pf_minio
S3_SECRET_KEY=pf_minio_local
S3_BUCKET=pf-files
S3_ENDPOINT=http://minio:9000
# 预签名 URL 对浏览器可达的地址（生产换公网域名）
S3_PUBLIC_ENDPOINT=http://localhost:19000

# ── svc-notify 通知服务（specs/017）──────────────────────────
NOTIFY_DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_svc_notify
# SMTP 出口（留空 = dev 模式：邮件只落库+日志，不真实外发）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── 账号自助流程（specs/018）────────────────────────────────
# 自助注册开关（默认关闭；on 开启 POST /auth/register）
PF_SELF_REGISTER=off
# svc-users 自有库（找回密码/邮箱验证码）+ 调 svc-notify 的凭据（pctl 注册生成）
USERS_DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_svc_users

# ── svc-jobs 任务队列/定时调度（specs/026）──────────────────
JOBS_DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_svc_jobs
# webhook 回调的签名身份（auth register-client 生成；空 = 回调不带 Authorization）
JOBS_CLIENT_ID=svc-jobs
JOBS_CLIENT_SECRET=

# ── svc-grants 业务角色分配（specs/027）─────────────────────
GRANTS_DATABASE_URL=postgres://platfarm:platfarm_local@postgres:5432/pf_svc_grants
